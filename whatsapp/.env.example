# Configuração da Evolution API — Valkyrie WhatsApp
# Copie este arquivo para .env e preencha com os dados da sua instância Evolution API

EVOLUTION_API_URL=https://sua-evolution-api.seudominio.com
EVOLUTION_API_KEY=sua-chave-global-ou-da-instancia
EVOLUTION_INSTANCE=valkyrie
BRUNO_WHATSAPP_NUMBER=5548999999999

# Webhook local (recebe ideias/mensagens do Bruno e registra no kanban-backlog.md)
WEBHOOK_PORT=3777
WEBHOOK_SECRET=defina-um-token-seguro

